# Copy these values into backend/.env (or your deployment secret store).
# Docker: host.docker.internal reaches Postgres on the host; use the real host/port on a VM.

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/expense_manager_DB

CORS_ORIGINS=http://localhost:9001,http://127.0.0.1:9001

# docker compose only: host port for the API (container port stays 8000).
BACKEND_PORT=9000
