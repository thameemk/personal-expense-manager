# Copy to web/.env. Used by docker compose; `pnpm dev` only reads VITE_API_URL.

# Baked into the bundle at build time (re-run `docker compose up --build` after changing).
# Must be the API URL as the browser sees it, i.e. the public host and BACKEND_PORT.
VITE_API_URL=http://localhost:9000/api/v1

# docker compose only: host port for the web app (container port stays 8080).
WEB_PORT=9001
